# AWS SDK uses these credentials for DynamoDB. Prefer an IAM role or AWS profile in production.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Set this only when using DynamoDB Local.
# DYNAMODB_ENDPOINT=http://localhost:8000

USERS_TABLE=cloudtrek-users
NOTES_TABLE=cloudtrek-notes

# Secret used to sign JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000
CORS_ORIGIN=http://localhost:5173
